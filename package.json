{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.1.0",
  "name": "effect-http-recorder",
  "description": "Record and replay Effect HTTP and WebSocket traffic with deterministic cassettes",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/effect-http-recorder.git"
  },
  "homepage": "https://github.com/anomalyco/effect-http-recorder#readme",
  "bugs": "https://github.com/anomalyco/effect-http-recorder/issues",
  "keywords": [
    "effect",
    "http",
    "recording",
    "replay",
    "testing",
    "vcr"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "provenance": true
  },
  "scripts": {
    "changeset": "changeset",
    "test": "bun test --timeout 30000 --only-failures",
    "typecheck": "tsgo --noEmit",
    "build": "bun ./script/build.ts",
    "verify:package": "bun ./script/verify-package.ts",
    "check": "bun run test && bun run typecheck && bunx prettier --check . && bunx oxlint src test script && bun run verify:package",
    "version": "changeset version",
    "release": "bun ./script/publish.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@tsconfig/node22": "22.0.2",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "effect": "4.0.0-beta.83",
    "oxlint": "1.60.0",
    "prettier": "3.6.2",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.83",
    "@effect/platform-node-shared": "4.0.0-beta.83"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.83"
  },
  "packageManager": "bun@1.3.14",
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
